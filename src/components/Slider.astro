---
import type { CollectionEntry } from 'astro:content';
import { getFormattedDate } from '../utils/global';
import 'swiper/css/bundle';

interface Props {
	posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

<section class="hero-slider-section" id="featured" aria-label="Artikel Sorotan">
	<div class="container">
		<div class="swiper hero-swiper">
			<div class="swiper-wrapper">
				{
					posts.map((post) => (
						<article class="swiper-slide hero-slide">
							<div
								class="hero-slide-bg"
								style={`background-image: url(${post.data.image});`}
								aria-hidden="true"
							/>
							<div class="hero-slide-scrim" aria-hidden="true" />
							<div class="hero-slide-content">
								<div class="hero-badges mb-3">
									<span class="hero-category">{post.data.category}</span>
									{post.data.isPinned && <span class="hero-pinned">Pilihan Editor</span>}
								</div>
								<h2 class="hero-title">
									<a href={`/blog/${post.id}`}>{post.data.title}</a>
								</h2>
								<p class="hero-excerpt">{post.data.excerpt}</p>
								<div class="hero-footer">
									<div class="hero-meta">
										<span class="hero-author-avatar" aria-hidden="true">
											{post.data.author.charAt(0).toUpperCase()}
										</span>
										<span class="hero-author">{post.data.author}</span>
										<span class="hero-sep" aria-hidden="true">&bull;</span>
										<time datetime={post.data.publishedAt}>
											{getFormattedDate(post.data.publishedAt)}
										</time>
									</div>
									<a href={`/blog/${post.id}`} class="hero-cta">
										Baca Artikel
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
											<path d="M5 12h14"></path>
											<path d="m12 5 7 7-7 7"></path>
										</svg>
									</a>
								</div>
							</div>
						</article>
					))
				}
			</div>

			<div class="hero-controls">
				<div class="swiper-pagination"></div>
				<div class="hero-nav-buttons d-none d-md-flex">
					<button type="button" class="hero-nav-btn hero-prev" aria-label="Slide sebelumnya">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="m15 18-6-6 6-6"></path>
						</svg>
					</button>
					<button type="button" class="hero-nav-btn hero-next" aria-label="Slide berikutnya">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="m9 18 6-6-6-6"></path>
						</svg>
					</button>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	import Swiper from 'swiper/bundle';

	new Swiper('.hero-swiper', {
		direction: 'horizontal',
		loop: true,
		speed: 700,
		autoplay: {
			delay: 7000,
			disableOnInteraction: false,
			pauseOnMouseEnter: true,
		},
		pagination: {
			el: '.hero-swiper .swiper-pagination',
			clickable: true,
		},
		navigation: {
			nextEl: '.hero-next',
			prevEl: '.hero-prev',
		},
	});
</script>

<style>
	.hero-slider-section {
		padding-top: 2rem;
		padding-bottom: 1rem;
	}

	.hero-swiper {
		width: 100%;
		height: 490px;
		border-radius: var(--radius-lg);
		overflow: hidden;
		box-shadow: var(--shadow-md);
		position: relative;
		background-color: #14181f;
	}

	.hero-slide {
		position: relative;
		display: flex;
		align-items: flex-end;
		width: 100%;
		height: 100%;
		overflow: hidden;
	}

	.hero-slide-bg {
		position: absolute;
		inset: 0;
		background-size: cover;
		background-position: center;
		transform: scale(1.02);
		transition: transform 6s ease-out;
	}

	.hero-slide.swiper-slide-active .hero-slide-bg {
		transform: scale(1.07);
	}

	.hero-slide-scrim {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			to top,
			rgba(15, 21, 31, 0.92) 0%,
			rgba(15, 21, 31, 0.58) 48%,
			rgba(15, 21, 31, 0.18) 100%
		);
	}

	.hero-slide-content {
		position: relative;
		z-index: 2;
		width: 100%;
		max-width: 780px;
		padding: 3rem 3rem 4.25rem;
		color: #ffffff;
	}

	.hero-badges {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
	}

	.hero-category {
		display: inline-block;
		padding: 0.3rem 0.85rem;
		border-radius: 999px;
		background-color: rgba(255, 255, 255, 0.16);
		border: 1px solid rgba(255, 255, 255, 0.25);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		color: #ffffff;
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.hero-pinned {
		display: inline-block;
		padding: 0.3rem 0.85rem;
		border-radius: 999px;
		background-color: var(--accent-warm);
		color: #ffffff;
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.hero-title {
		font-family: var(--font-serif);
		font-size: clamp(1.65rem, 3.2vw, 2.65rem);
		font-weight: 600;
		line-height: 1.18;
		margin-bottom: 0.85rem;
		color: #ffffff;
	}

	.hero-title a {
		color: inherit;
		text-decoration: none;
		background-image: linear-gradient(currentColor, currentColor);
		background-position: 0% 100%;
		background-repeat: no-repeat;
		background-size: 0% 2px;
		transition: background-size 300ms ease, color var(--transition-base);
	}

	.hero-title a:hover {
		color: #f8f4ef;
		background-size: 100% 2px;
	}

	.hero-excerpt {
		font-size: 0.98rem;
		line-height: 1.65;
		color: rgba(255, 255, 255, 0.82);
		margin-bottom: 1.5rem;
		max-width: 640px;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.hero-footer {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.hero-meta {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		font-size: 0.875rem;
		color: rgba(255, 255, 255, 0.88);
	}

	.hero-author-avatar {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 28px;
		height: 28px;
		border-radius: 999px;
		background-color: rgba(255, 255, 255, 0.2);
		border: 1px solid rgba(255, 255, 255, 0.35);
		font-size: 0.78rem;
		font-weight: 600;
		color: #ffffff;
	}

	.hero-author {
		font-weight: 500;
	}

	.hero-sep {
		opacity: 0.55;
	}

	.hero-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.55rem 1.2rem;
		border-radius: 999px;
		background-color: #ffffff;
		color: var(--ink-primary);
		font-size: 0.85rem;
		font-weight: 600;
		text-decoration: none;
		transition: transform var(--transition-base), background-color var(--transition-base),
			color var(--transition-base);
	}

	.hero-cta svg {
		width: 15px;
		height: 15px;
		transition: transform var(--transition-base);
	}

	.hero-cta:hover {
		background-color: var(--accent-warm);
		color: #ffffff;
		transform: translateY(-1px);
	}

	.hero-cta:hover svg {
		transform: translateX(3px);
	}

	.hero-controls {
		position: absolute;
		left: 3rem;
		right: 3rem;
		bottom: 1.5rem;
		z-index: 10;
		display: flex;
		align-items: center;
		justify-content: space-between;
		pointer-events: none;
	}

	.hero-controls :global(.swiper-pagination) {
		position: static;
		width: auto;
		display: flex;
		align-items: center;
		gap: 0.4rem;
		pointer-events: auto;
	}

	.hero-controls :global(.swiper-pagination-bullet) {
		width: 8px;
		height: 8px;
		margin: 0 !important;
		border-radius: 999px;
		background-color: rgba(255, 255, 255, 0.45);
		opacity: 1;
		transition: width 260ms ease, background-color 260ms ease;
	}

	.hero-controls :global(.swiper-pagination-bullet-active) {
		width: 26px;
		background-color: #ffffff;
	}

	.hero-nav-buttons {
		gap: 0.5rem;
		pointer-events: auto;
	}

	.hero-nav-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 38px;
		height: 38px;
		border-radius: 999px;
		border: 1px solid rgba(255, 255, 255, 0.25);
		background-color: rgba(255, 255, 255, 0.12);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		color: #ffffff;
		cursor: pointer;
		transition: background-color var(--transition-base), border-color var(--transition-base),
			transform var(--transition-base);
	}

	.hero-nav-btn svg {
		width: 18px;
		height: 18px;
	}

	.hero-nav-btn:hover {
		background-color: rgba(255, 255, 255, 0.26);
		border-color: rgba(255, 255, 255, 0.5);
		transform: translateY(-1px);
	}

	@media (max-width: 767.98px) {
		.hero-swiper {
			height: 440px;
			border-radius: var(--radius-md);
		}

		.hero-slide-content {
			padding: 1.75rem 1.5rem 3.5rem;
		}

		.hero-controls {
			left: 1.5rem;
			right: 1.5rem;
			bottom: 1.25rem;
		}
	}
</style>
