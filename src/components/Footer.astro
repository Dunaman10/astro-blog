---
const year = new Date().getFullYear();
---

<footer class="site-footer mt-5">
	<div class="container py-5">
		<div class="row gy-4 align-items-center justify-content-between">
			<div class="col-lg-6">
				<a class="footer-brand d-inline-flex align-items-center gap-2 text-decoration-none mb-2" href="/">
					<span class="footer-mark" aria-hidden="true">A</span>
					<span class="footer-brand-name">AstroJournal<span class="brand-dot">.</span></span>
				</a>
				<p class="footer-desc mb-0">
					Ruang baca seputar pemrograman, karir, keuangan, dan gaya hidup modern — dirangkum dengan jernih untuk menemani keseharian Anda.
				</p>
			</div>
			<div class="col-lg-5 text-lg-end">
				<ul class="list-inline mb-2 footer-links">
					<li class="list-inline-item"><a href="/">Beranda</a></li>
					<li class="list-inline-item"><a href="/#featured">Sorotan</a></li>
					<li class="list-inline-item"><a href="/#articles">Semua Artikel</a></li>
				</ul>
				<p class="footer-copy mb-0">&copy; {year} AstroJournal. Dibangun dengan Astro &amp; Bootstrap.</p>
			</div>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		background-color: var(--bg-surface);
		border-top: 1px solid var(--border-subtle);
	}

	.footer-mark {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 28px;
		height: 28px;
		border-radius: 8px;
		background: linear-gradient(135deg, var(--accent-primary), #2b4f7d);
		color: #ffffff;
		font-family: var(--font-serif);
		font-weight: 700;
		font-size: 0.95rem;
	}

	.footer-brand-name {
		font-family: var(--font-serif);
		font-size: 1.2rem;
		font-weight: 600;
		color: var(--ink-primary);
	}

	.brand-dot {
		color: var(--accent-warm);
	}

	.footer-desc {
		font-size: 0.9rem;
		color: var(--ink-muted);
		max-width: 460px;
	}

	.footer-links {
		display: inline-flex;
		gap: 1.25rem;
	}

	.footer-links a {
		font-size: 0.875rem;
		font-weight: 500;
		color: var(--ink-body);
		text-decoration: none;
	}

	.footer-links a:hover {
		color: var(--accent-warm);
	}

	.footer-copy {
		font-size: 0.82rem;
		color: var(--ink-muted);
	}
</style>
